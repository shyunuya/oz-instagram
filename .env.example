# 공공데이터포털 > 마이페이지 > 한국관광공사_관광사진 정보_GW 인증키 (일반 인증키 Decoding/Encoding 둘 다 됨)
KTO_SERVICE_KEY=

# Meta 개발자 앱 > Instagram > API setup with Instagram login > Generate token
