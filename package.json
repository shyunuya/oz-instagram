{
  "name": "oz-instagram",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "plan-week": "node --env-file-if-exists=.env src/plan-week.ts",
    "publish": "node --env-file-if-exists=.env src/publish.ts",
    "validate": "node src/validate.ts",
    "check-supply": "node --env-file-if-exists=.env scripts/check-supply.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc",
    "format": "prettier --write config src scripts tests",
    "format:check": "prettier --check config src scripts tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
